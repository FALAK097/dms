{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dms",
  "main": ".open-next/worker.js",
  "build": {
    "command": "pnpm run build:cf"
  },
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DMS_KV",
      "id": "da382fa8cbee4be9a5d2fe6447d396b9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DMS_BUCKET",
      "bucket_name": "dms-uploads"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://dms.falakgala.dev",
    "BETTER_AUTH_URL": "https://dms.falakgala.dev",
    "CLOUDFLARE_QUEUE_WORKER_URL": "https://dms-jobs.widget-chat.workers.dev"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "dms.falakgala.dev",
      "custom_domain": true
    }
  ]
}
